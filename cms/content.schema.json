{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Portfolio CMS version 3 local draft",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "translations",
    "static",
    "staticLocales",
    "content"
  ],
  "properties": {
    "version": {
      "const": 3
    },
    "translations": {
      "$ref": "#/$defs/dictionaries"
    },
    "static": {
      "type": "object",
      "additionalProperties": false,
      "properties": {},
      "required": []
    },
    "staticLocales": {
      "$ref": "#/$defs/dictionaries"
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sections": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/componentSection"
          },
          "maxItems": 60
        },
        "fields": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/localeOverrides"
          }
        },
        "attributes": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/attributes"
          }
        },
        "links": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/componentLink"
          },
          "maxItems": 300
        }
      },
      "required": [
        "sections",
        "fields",
        "attributes",
        "links"
      ]
    }
  },
  "$defs": {
    "localizedText": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "en",
        "es",
        "ca",
        "fr"
      ],
      "properties": {
        "en": {
          "type": "string"
        },
        "es": {
          "type": "string"
        },
        "ca": {
          "type": "string"
        },
        "fr": {
          "type": "string"
        }
      }
    },
    "link": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "href"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]*$"
        },
        "label": {
          "$ref": "#/$defs/localizedText"
        },
        "href": {
          "type": "string"
        },
        "external": {
          "type": "boolean"
        }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "body"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]*$"
        },
        "title": {
          "$ref": "#/$defs/localizedText"
        },
        "subtitle": {
          "$ref": "#/$defs/localizedText"
        },
        "body": {
          "$ref": "#/$defs/localizedText"
        },
        "links": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/link"
          }
        },
        "image": {
          "type": "string"
        }
      }
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "visible",
        "navLabel",
        "heading",
        "entries"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*$"
        },
        "kind": {
          "enum": [
            "hero",
            "education",
            "experience",
            "projects",
            "custom"
          ]
        },
        "visible": {
          "type": "boolean"
        },
        "navLabel": {
          "$ref": "#/$defs/localizedText"
        },
        "heading": {
          "$ref": "#/$defs/localizedText"
        },
        "intro": {
          "$ref": "#/$defs/localizedText"
        },
        "entries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/entry"
          }
        }
      }
    },
    "localeOverrides": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "en": {
          "type": "string"
        },
        "es": {
          "type": "string"
        },
        "ca": {
          "type": "string"
        },
        "fr": {
          "type": "string"
        }
      },
      "required": []
    },
    "dictionaries": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "en": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "es": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "ca": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "fr": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "required": [
        "en",
        "es",
        "ca",
        "fr"
      ]
    },
    "componentEntry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,90}$"
        },
        "template": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "template"
      ]
    },
    "componentSection": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,90}$"
        },
        "template": {
          "type": "string"
        },
        "entries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/componentEntry"
          },
          "maxItems": 150
        }
      },
      "required": [
        "id",
        "template",
        "entries"
      ]
    },
    "attributes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "href": {
          "type": "string"
        },
        "src": {
          "type": "string"
        },
        "alt": {
          "$ref": "#/$defs/localeOverrides"
        },
        "removed": {
          "type": "boolean"
        }
      },
      "required": []
    },
    "componentLink": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "owner": {
          "type": "string"
        },
        "href": {
          "type": "string"
        },
        "label": {
          "$ref": "#/$defs/localeOverrides"
        }
      },
      "required": [
        "id",
        "owner",
        "href",
        "label"
      ]
    }
  },
  "description": "Version 3 evolves the original section/entry design with trusted template references, locale field overrides, image/link attributes and phase-2 translations. Templates are defined by the preserved baseline markup, never supplied by imported JSON."
}
